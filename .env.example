# URL async (usada por el proceso API) - driver asyncpg
DATABASE_URL_ASYNC=postgresql+asyncpg://pjud:pjud@localhost:5432/pjud

# URL sync (usada por el proceso worker) - driver psycopg (v3)
DATABASE_URL_SYNC=postgresql+psycopg://pjud:pjud@localhost:5432/pjud

# Base publica usada para construir las URLs de documentos (https://api-pjud.temposoft.cl/public/...)
PUBLIC_BASE_URL=https://api-pjud.temposoft.cl

# Carpeta donde se guardan los PDF descargados
DOCUMENTOS_DIR=./documentos

# Carpeta de logs
LOG_DIR=./logs

# Minutos tras los cuales un lock de sincronizacion "Sincronizando" se considera huerfano
SYNC_LOCK_TIMEOUT_MINUTES=15

# Minutos minimos entre dos sincronizaciones exitosas de la misma causa
SYNC_MIN_INTERVAL_MINUTES=30

# El sitio de PJUD detecta y bloquea navegadores headless (con headless=True nunca carga
# el widget de busqueda) -- probado en vivo durante el desarrollo. Debe quedar en False.
PLAYWRIGHT_HEADLESS=False

# Copiar a .env (misma carpeta que docker-compose.yml) y ajustar antes de levantar el stack.
# docker compose carga este .env automaticamente para sustituir las variables ${...}
# del docker-compose.yml.

POSTGRES_USER=pjud
POSTGRES_PASSWORD=cambiar-esta-clave
POSTGRES_DB=pjud

# Puerto del host donde se publica la API (el contenedor siempre escucha en 8000
# internamente; esto solo cambia el mapeo hacia afuera).
API_PORT=7092

# Base publica usada para construir las URLs de documentos servidas por /public/...
PUBLIC_BASE_URL=https://api-pjud.temposoft.cl

SYNC_LOCK_TIMEOUT_MINUTES=15
SYNC_MIN_INTERVAL_MINUTES=30
